# XGEN CREATOR — 예시 환경변수 (실값은 .env에만, 커밋 금지)

# 대상 프론트/백엔드 (로컬 스택 기준 예시)
XGEN_CREATOR_BASE_URL=http://localhost:3000
XGEN_CREATOR_BACKEND_URL=http://localhost:8000

# 트레이스 저장 위치 (미들웨어와 브리지가 공유)
XGEN_CREATOR_TRACE_DIR=.creator/traces

# 모델 역할 (에이전트=오케스트레이션, source=소스 서술/문서화)
XGEN_CREATOR_MODEL_AGENT=claude-opus-4-8
XGEN_CREATOR_MODEL_SOURCE=claude-fable-5

# LLM 엔드포인트 (선택 — 없으면 결정론 코어만 동작)
# XGEN_CREATOR_LLM_BASE_URL=
# XGEN_CREATOR_LLM_API_KEY=
